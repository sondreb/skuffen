{
  "name": "skuffen",
  "version": "0.1.55",
  "private": true,
  "description": "Local-only personal intelligence. People-graph on your machine as OKF.",
  "license": "MIT",
  "author": "Sondre Bjellås",
  "homepage": "https://skuffen.grok.me",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "mcp": "tsx mcp/src/server.ts",
    "test:okf": "tsx --test packages/okf/src/okf.test.ts packages/okf/src/vault.test.ts packages/okf/src/place.test.ts packages/okf/src/relations.test.ts",
    "test:vault": "tsx --test packages/okf/src/vault.test.ts",
    "test:mcp": "tsx --test mcp/src/redact.test.ts mcp/src/bundle.test.ts mcp/src/http-guard.test.ts",
    "test:secrets": "tsx --test src/app/services/web-secrets.test.ts",
    "test:oauth": "tsx --test src/app/services/grok-oauth.test.ts src/app/services/providers.service.test.ts",
    "test:research": "tsx --test src/app/services/research.test.ts src/app/services/page-photos.test.ts src/app/services/memory.test.ts src/app/list-photo.test.ts",
    "test:imagine": "tsx --test src/app/services/imagine.test.ts src/app/list-photo.test.ts src/app/image-preview.test.ts",
    "test:self": "tsx --test src/app/services/self.test.ts",
    "test:theme": "tsx --test src/app/services/theme.test.ts",
    "test:people-pane": "tsx --test src/app/services/people-pane.test.ts",
    "test:people-sort": "tsx --test src/app/services/people-sort.test.ts",
    "test:merge": "tsx --test src/app/services/merge.test.ts",
    "test:brief": "tsx --test src/app/services/brief.test.ts",
    "test:capture": "tsx --test src/app/services/capture.test.ts",
    "test:shuffle": "tsx --test src/app/services/shuffle.test.ts",
    "test:timeline": "tsx --test src/app/services/timeline.test.ts",
    "test:commitments": "tsx --test src/app/services/commitments.test.ts",
    "test:relations": "tsx --test src/app/services/relations.test.ts",
    "test:map": "tsx --test src/app/map/map-edges.test.ts src/app/map/map-pins.test.ts",
    "test:graph": "tsx --test src/app/graph/graph-edges.test.ts",
    "test:gallery": "tsx --test src/app/gallery/people-gallery.test.ts",
    "test:view-history": "tsx --test src/app/services/view-history.test.ts",
    "test:places": "tsx --test src/app/services/places.test.ts",
    "test:tags": "tsx --test src/app/services/tags.test.ts",
    "test:card-tabs": "tsx --test src/app/card-tabs.test.ts src/app/file-open.test.ts",
    "test:update": "tsx --test src/app/services/update.test.ts",
    "test:version": "tsx --test scripts/bump-version.test.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "demo:record": "DEMO_RECORD=1 playwright test --config e2e/playwright.config.ts --workers=1 && node scripts/curate-demo-media.mjs",
    "version:lockstep": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@google/genai": "^1.30.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "yaml": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/leaflet": "^1.9.21",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
}
